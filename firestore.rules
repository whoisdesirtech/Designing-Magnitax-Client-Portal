rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // users/{uid} — clients manage their own profile; admins manage everyone.
    // Role escalation is closed: a user may only create their own profile as
    // 'client' and may never change their own role on update. Only admins may
    // create/update profiles with any role (e.g., provisioning).
    match /users/{userId} {
      allow read: if isAdmin() || request.auth != null && request.auth.uid == userId;
      allow create: if isAdmin()
        || (request.auth != null
            && request.auth.uid == userId
            && request.resource.data.role == 'client');
      allow update: if isAdmin()
        || (request.auth != null
            && request.auth.uid == userId
            && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    // invites — pending client invitations. Token id is unguessable and grants
    // read-by-get so the activation page (pre-auth) can validate the link.
    // Only admins may create/delete invites; activation flips status to
    // 'activated' (no role data flows through the invite).
    match /invites/{inviteId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (request.auth != null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'activatedBy', 'activatedAt'])
            && request.resource.data.status == 'activated'
            && request.resource.data.activatedBy == request.auth.uid);
    }

    // documents — clients read only their own; only admins write.
    match /documents/{docId} {
      allow read: if isAdmin()
        || (request.auth != null && resource.data.clientUid == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    // intakes — any authenticated user may submit; only admins read/update/delete.
    // Blocks clients from reading other clients' intakes (SSN/DOB live here).
    match /intakes/{intakeId} {
      allow create: if request.auth != null;
      allow read, update, delete: if isAdmin();
    }

    // leads — public marketing forms (coffee.html) write; only admins read/update/delete.
    match /leads/{leadId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // auditLogs — server-written only (Admin SDK bypasses rules); admins may read.
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
